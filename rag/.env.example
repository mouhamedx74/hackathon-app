# Copier ce fichier en .env pour surcharger les réglages (lu par docker compose).
# OLLAMA_HOST et CHROMA_DIR sont imposés par docker-compose.yml dans le conteneur ;
# en local sans Docker, utiliser OLLAMA_HOST=http://localhost:11434.

OLLAMA_HOST=http://ollama:11434
EMBED_MODEL=nomic-embed-text
LLM_MODEL=qwen2.5:1.5b
COLLECTION_NAME=story
CHUNK_SIZE=800
CHUNK_OVERLAP_PARAGRAPHS=1
TOP_K=4
MIN_SCORE=0.3
CACHE_TTL=300
CACHE_MAX_SIZE=100

# ngrok (obligatoire pour exposer l'API en dev ; token gratuit sur https://dashboard.ngrok.com)
NGROK_AUTHTOKEN=ton_token_ici
# NGROK_DOMAIN=ton-domaine.ngrok-free.app   # optionnel : domaine fixe réservé sur ngrok

